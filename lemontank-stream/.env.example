# ═══════════════════════════════════════════════════════════════════════════
#  LemonTank Stream — קובץ משתני סביבה
#  העתק לקובץ בשם  .env.local  ומלא ערכים אמיתיים.  אל תעלה .env.local ל-Git!
# ═══════════════════════════════════════════════════════════════════════════

# ── חובה: סודות. הפק אותם כך:  node scripts/gen-secrets.mjs ────────────────
# חתימת עוגיות/טוקנים — לפחות 32 תווים אקראיים
APP_SECRET="החלף-אותי-בסוד-אקראי-ארוך-מאוד-לפחות-32-תווים"
# חתימת CSRF — סוד נוסף ונפרד (אל תשתמש באותו ערך)
CSRF_SECRET="החלף-אותי-בסוד-אקראי-אחר-לפחות-32-תווים"
# חתימת קישורי מדיה זמניים (video/upload signed URLs)
MEDIA_SECRET="החלף-אותי-בסוד-שלישי-אקראי-לפחות-32-תווים"

# ── מסד נתונים ────────────────────────────────────────────────────────────
# ברירת מחדל — SQLite מובנה (חינם, ללא הגבלה, קובץ מקומי)
DATABASE_DRIVER="sqlite"
DATABASE_FILE="./data/lemontank.db"

# אופציונלי — PostgreSQL חינמי בענן (Neon / Supabase / Railway).
# אם מגדירים כתובת, האפליקציה משתמשת ב-Postgres במקום SQLite.
#   Neon:     postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/lemontank?sslmode=require
#   Supabase: postgresql://postgres.user:pass@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# DATABASE_URL=""

# ── כתובת האתר ────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
NODE_ENV="development"
# הפוך ל-"true" מאחורי HTTPS בפרודקשן (כופה Secure על עוגיות + HSTS)
COOKIE_SECURE="false"

# ── אדמין ראשון (נוצר ע"י סקריפט ה-seed) ──────────────────────────────────
SEED_ADMIN_EMAIL="admin@lemontank.local"
SEED_ADMIN_PASSWORD="Admin!Lemon2026#Strong"

# ── הגבלות העלאה ─────────────────────────────────────────────────────────
MAX_IMAGE_UPLOAD_MB="8"
MAX_VIDEO_UPLOAD_MB="2048"

# ── אינטגרציות אופציונליות ────────────────────────────────────────────────
# TMDB (לסנכרון מטא-דאטה של סרטים) — המפתח חינם: https://www.themoviedb.org/settings/api
TMDB_API_KEY=""
# חתימת Webhook לתשלומים
PAYMENT_WEBHOOK_SECRET=""
# SMTP לשליחת מיילים (שחזור סיסמה / אימות מייל)
SMTP_URL=""

# ── פרוקסי ואבטחת פריימים ─────────────────────────────────────────────────
# הפעל כשיש reverse proxy (nginx/Cloudflare) — אז מזהי ה-IP נלקחים מ-X-Forwarded-For
# TRUST_PROXY="true"

# מקורות מורשים לבקשות משנות-מצב בקליינטים אחרים (מופרד בפסיק).
# ברירת מחדל: אותה כתובת שממנה הגיעה הבקשה + APP_URL. נדרש רק אם יש דומיין נוסף.
# ALLOWED_ORIGINS="https://www.example.com,https://app.example.com"

# מי רשאי להטמיע את האתר ב-iframe (CSP frame-ancestors).
# ברירת מחדל מתאימה גם להרצה מקומית וגם לסביבות תצוגה מקדימה בענן.
# ALLOW_FRAME_ANCESTORS="'self' https://*.e2b.app https://example.com"

# ── אחסון מדיה ────────────────────────────────────────────────────────────
# תיקיית האחסון לקבצים שהועלו (ברירת מחדל: ./storage)
# STORAGE_ROOT="./storage"
