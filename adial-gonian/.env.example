# ============================================
# אדיאל גוניור - Adial Gonian Configuration
# ============================================

# AI Provider: "openai" or "anthropic"
AI_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o

# Anthropic Configuration  
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Speech Configuration
# Wake word to activate the assistant
WAKE_WORD=אדיאל גוניון

# TTS Voice (Edge-TTS Hebrew voices: he-IL-HilaNeural, he-IL-AvriNeural)
TTS_VOICE=he-IL-HilaNeural

# Whisper model size: tiny, base, small, medium, large
WHISPER_MODEL=base

# Vosk model path (download from https://alphacephei.com/vosk/models)
# For Hebrew: vosk-model-he-0.4 or use multilingual model
VOSK_MODEL_PATH=./models/vosk-model-small-en-us-0.15

# Screen Capture
SCREEN_CAPTURE_INTERVAL=2.0
SCREEN_CAPTURE_QUALITY=80

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8765

# UI Configuration
HUD_DEFAULT_POSITION=center
HUD_OPACITY=0.85
HUD_THEME=iron-man

# Language
PRIMARY_LANGUAGE=he
